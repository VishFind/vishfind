# Скопируйте в .env (файл .env в Git не попадает).
# Ключи никогда не кладите во frontend и не присылайте в чат.
#
# Разделение сред: NODE_ENV=development (локально) / NODE_ENV=production (хостинг).
# На хостинге платформа сама задаёт PORT и часто NODE_ENV — не переопределяйте их в .env.

# ============================================================================
# Общие настройки
# ============================================================================

# development | production. По умолчанию development.
# В production фотоанализ выключен по умолчанию (AI_ENABLED=false).
NODE_ENV=development

# Порт и адрес прослушивания (на хостинге PORT задаёт платформа).
PORT=3000
HOST=0.0.0.0

# Доверять заголовку X-Forwarded-For (используется для rate limit по IP).
# Локально: false (клиент не может подделать IP).
# Production за платформенным прокси: true.
TRUST_PROXY=false

# Закрытый тест всего сайта (страницы, статика и API), не полноценный вход.
# Пока BASIC_AUTH_ENABLED не равен true, защита выключена.
# Логин и пароль задайте сами в локальном .env или в переменных платформы.
# Не коммитьте пароль и не кладите его во frontend. На хостинге — только через HTTPS.
# Если включить true и оставить логин или пароль пустым, сервер не запустится.
# Открытый для платформы адрес: GET /api/healthz — только {"ok":true}, без настроек.
BASIC_AUTH_ENABLED=
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Уровень логов: error | warn | info | debug.
# Локально удобен debug; в production достаточно warn (меньше шума, ошибки видны).
LOG_LEVEL=debug

# Rate limit: максимум запросов /api/search и /api/find с одного IP за окно.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=60

# ============================================================================
# Development (локально, с Ollama)
# ============================================================================

# true — кнопка «Фото» и разбор через Ollama (нужна локальная/доступная Ollama).
# На хостинге без Ollama поставьте false — текстовый поиск останется.
AI_ENABLED=true

# Веб-поиск Ollama (https://docs.ollama.com/capabilities/web-search).
# Ключ только на сервере. Не коммитьте значение.
# Включается только при явном WEB_SEARCH_ENABLED=true И наличии ключа.
# Наличие OLLAMA_API_KEY само по себе web_search не включает.
# Пользовательский переключатель в UI тоже нужен (body.web_search=true).
# WEB_SEARCH_ENABLED=false
# WEB_SEARCH_ENABLED=true
# OLLAMA_API_KEY=
# OLLAMA_WEB_FETCH=true   # опционально: один web_fetch после поиска (квота); не следует из web_search

# TAVILY_API_KEY=

# --- разбор фото (если AI_ENABLED=true) ---
# Явный выбор провайдера. Без авто-переключения ollama↔timeweb.
# PHOTO_PROVIDER=ollama
# PHOTO_PROVIDER=timeweb

# Ollama (PHOTO_PROVIDER=ollama):
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct
OLLAMA_TIMEOUT_SEC=90
PHOTO_TIMEOUT_SEC=90
# Общий бюджет одного разбора (все попытки), с запасом к прокси ~120 с.
PHOTO_TOTAL_BUDGET_SEC=105
# schema | twopass | auto
PHOTO_PIPELINE=schema
# Одновременные разборы фото (1 = безопасный дефолт для локальной Ollama).
# PHOTO_CONCURRENCY=1

# Timeweb AI Gateway (PHOTO_PROVIDER=timeweb). Ключ ТОЛЬКО на сервере, не в Git.
# TIMEWEB_AI_API_KEY=
# TIMEWEB_AI_URL=https://api.timeweb.ai/v1/chat/completions
# TIMEWEB_AI_MODEL=openai/gpt-4o-mini

# ============================================================================
# Production (публичный деплой)
# ============================================================================
#
# Минимальный набор для первого деплоя (без Ollama и без ключей):
#   NODE_ENV=production
#   AI_ENABLED=false
#   TRUST_PROXY=true
#   LOG_LEVEL=warn
#   PORT=<задаёт платформа>
#   HOST=0.0.0.0
#
# В production фотоанализ по умолчанию выключен: локальной Ollama на хостинге нет.
# Лимит тела запроса в production — 64 КБ (фото-путь недостижим).

# --- eBay Browse API (реальные предложения, опционально) ---
# Ключи создаются в developer.ebay.com. Без них реальные предложения не запрашиваются,
# поиск работает с демо-предложениями и ссылками на площадки.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE=EBAY_US

# Circuit breaker eBay: порог последовательных ошибок и пауза (сек).
# После открытия запросы к eBay не выполняются, отдаётся фолбэк.
EBAY_CIRCUIT_THRESHOLD=3
EBAY_CIRCUIT_COOLDOWN_SEC=60
