# Скопируйте в .env (файл .env в Git не попадает).
# Ключи никогда не кладите во frontend и не присылайте в чат.

# Разбор фото через локальную Ollama (бесплатно, но нужна установка у вас на ПК).
# Текстовый поиск работает и при false. Для кнопки «Фото» поставьте true.
AI_ENABLED=true

# Порт сервера
PORT=3000

# Веб-поиск выключен по умолчанию. Даже при наличии ключа нужен явный true.
# Бесплатные квоты не гарантированы; сервис может просить карту — не считайте это «бесплатно навсегда».
# Цены товаров мы всё равно не обещаем: сниппеты поисковиков ненадёжны.
WEB_SEARCH_ENABLED=false
# TAVILY_API_KEY=

# Настройки Ollama (для фото):
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b
# OLLAMA_TIMEOUT_SEC=300
# OLLAMA_API_KEY=
