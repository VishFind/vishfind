# Скопируйте в .env (файл .env в Git не попадает).
# Ключи никогда не кладите во frontend и не присылайте в чат.

# Разбор фото через локальную Ollama (бесплатно, но нужна установка у вас на ПК).
# Текстовый поиск работает и при false. Для кнопки «Фото» поставьте true.
AI_ENABLED=true

# Порт сервера
PORT=3000

# Веб-поиск выключен по умолчанию.
WEB_SEARCH_ENABLED=false
# TAVILY_API_KEY=

# Ollama для фото (structured outputs — лучше Ollama 0.5+, рекомендуется свежий релиз)
OLLAMA_URL=http://127.0.0.1:11434
# Лучше *-instruct: иначе ответ может уйти в thinking, а content останется пустым
OLLAMA_MODEL=qwen3-vl:2b-instruct
OLLAMA_TIMEOUT_SEC=90
PHOTO_TIMEOUT_SEC=90
# OLLAMA_API_KEY=
